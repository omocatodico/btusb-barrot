+/* Right after an LE connection the controller answers LE Read Remote Used
+ * Features with Controller Busy, and the core drops the connection. Turn
+ * the error into success and complete the procedure with no features.
+ */
+static int btusb_barrot_fake_remote_features(struct hci_dev *hdev,
+					     struct sk_buff *skb)
+{
+	struct btusb_data *data = hci_get_drvdata(hdev);
+	struct hci_ev_cmd_status *cs;
+	struct hci_ev_le_remote_feat_complete *ev;
+	struct sk_buff *nskb;
+	int err;
+
+	cs = (void *)(skb->data + HCI_EVENT_HDR_SIZE);
+	bt_dev_warn(hdev, "Barrot: remote features status 0x%2.2x, faking completion",
+		    cs->status);
+	cs->status = 0x00;
+
+	nskb = bt_skb_alloc(HCI_EVENT_HDR_SIZE + 1 + sizeof(*ev), GFP_ATOMIC);
+	if (!nskb)
+		return hci_recv_frame(hdev, skb);
+
+	hci_skb_pkt_type(nskb) = HCI_EVENT_PKT;
+	skb_put_u8(nskb, HCI_EV_LE_META);
+	skb_put_u8(nskb, 1 + sizeof(*ev));
+	skb_put_u8(nskb, HCI_EV_LE_REMOTE_FEAT_COMPLETE);
+	ev = skb_put_zero(nskb, sizeof(*ev));
+	ev->handle = data->barrot_feat_handle;
+
+	err = hci_recv_frame(hdev, skb);
+	if (err) {
+		kfree_skb(nskb);
+		return err;
+	}
+
+	return hci_recv_frame(hdev, nskb);
+}
+
+static int btusb_recv_event_barrot(struct hci_dev *hdev, struct sk_buff *skb)
+{
+	struct hci_ev_cmd_complete *cc;
+	struct hci_ev_cmd_status *cs;
+	struct hci_rp_le_read_local_features *rp;
+
+	if (barrot_legacy_le &&
+	    skb->len >= HCI_EVENT_HDR_SIZE + sizeof(*cs) &&
+	    skb->data[0] == HCI_EV_CMD_STATUS) {
+		cs = (void *)(skb->data + HCI_EVENT_HDR_SIZE);
+
+		if (__le16_to_cpu(cs->opcode) == HCI_OP_LE_READ_REMOTE_FEATURES &&
+		    cs->status == 0x3a)	/* Controller Busy */
+			return btusb_barrot_fake_remote_features(hdev, skb);
+	}
+
+	/* Hide LE extended advertising: once an extended command has been
+	 * sent the controller answers the legacy scan commands with
+	 * Command Disallowed, and the extended scan ones hang it.
+	 */
+	if (barrot_legacy_le &&
+	    skb->len >= HCI_EVENT_HDR_SIZE + sizeof(*cc) + sizeof(*rp) &&
+	    skb->data[0] == HCI_EV_CMD_COMPLETE) {
+		cc = (void *)(skb->data + HCI_EVENT_HDR_SIZE);
+		rp = (void *)(skb->data + HCI_EVENT_HDR_SIZE + sizeof(*cc));
+
+		if (__le16_to_cpu(cc->opcode) == HCI_OP_LE_READ_LOCAL_FEATURES &&
+		    !rp->status && rp->features[1] & HCI_LE_EXT_ADV) {
+			bt_dev_info(hdev, "Barrot: hiding LE extended advertising");
+			rp->features[1] &= ~HCI_LE_EXT_ADV;
+		}
+	}
+
+	return hci_recv_frame(hdev, skb);
+}
